# =============================================================================
# Cubo Itaú — Startup Data Extractor
# =============================================================================
# Copie este arquivo para .env e preencha os valores.

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# Encontre em: Supabase Dashboard > Settings > API
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------------
# Cubo Itaú — credenciais de acesso
# ---------------------------------------------------------------------------
# Login usado para acessar app.cubo.itau.
# Necessário caso a vitrine de startups exija autenticação.
CUBO_EMAIL=seu@email.com
CUBO_PASSWORD=sua-senha

# ---------------------------------------------------------------------------
# Selenium — opções do navegador (opcionais)
# ---------------------------------------------------------------------------
# Exibe o navegador durante a execução. Desative em produção/CI.
HEADLESS=false

# Tempo máximo de espera por elemento (segundos).
SELENIUM_TIMEOUT=15

# Intervalo entre requisições para evitar bloqueio (segundos).
REQUEST_DELAY=1.5
