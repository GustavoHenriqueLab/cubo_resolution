# =============================================================================
# Cubo Itau — Startup Data Extractor
# =============================================================================
# Copie este arquivo para .env e preencha os valores.

# ---------------------------------------------------------------------------
# Cubo Itau — credenciais de acesso
# ---------------------------------------------------------------------------
# Login usado para acessar app.cubo.itau.
# Necessario caso a vitrine de startups exija autenticacao.
CUBO_EMAIL=seu@email.com
CUBO_PASSWORD=sua-senha

# ---------------------------------------------------------------------------
# Selenium — opcoes do navegador (opcionais)
# ---------------------------------------------------------------------------
# Exibe o navegador durante a execucao. Desative em producao/CI.
HEADLESS=false

# Tempo maximo de espera por elemento (segundos).
SELENIUM_TIMEOUT=15

# Intervalo entre requisicoes para evitar bloqueio (segundos).
REQUEST_DELAY=1.5

# ---------------------------------------------------------------------------
# Google Gemini — API Key e configuracao
# ---------------------------------------------------------------------------
# Chave da API Google Gemini (obrigatorio)
GEMINI_API_KEY=

# Modelo Gemini a ser utilizado
GEMINI_MODEL=gemini-3.5-flash-lite

# Quantidade de startups enviadas por chamada ao Gemini
STARTUP_BATCH_SIZE=5

# Numero maximo de tentativas em caso de erro temporario de cota
GEMINI_MAX_RETRIES=3

# Intervalo entre lotes (segundos) para evitar limite de RPM
GEMINI_DELAY_BETWEEN_BATCHES_SECONDS=2
