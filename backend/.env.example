# =============================================================================
# Cubo Itau — Startup Data Extractor
# =============================================================================
# Copie este arquivo para .env e preencha os valores.

# ---------------------------------------------------------------------------
# Cubo Itau — credenciais de acesso
# ---------------------------------------------------------------------------
CUBO_EMAIL=seu@email.com
CUBO_PASSWORD=sua-senha

# ---------------------------------------------------------------------------
# Selenium — opcoes do navegador (opcionais)
# ---------------------------------------------------------------------------
HEADLESS=false
SELENIUM_TIMEOUT=15
REQUEST_DELAY=1.5

# ---------------------------------------------------------------------------
# Google Gemini — API Key e configuracao
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
STARTUP_BATCH_SIZE=5
GEMINI_MAX_RETRIES=3
GEMINI_DELAY_BETWEEN_BATCHES_SECONDS=2

# ---------------------------------------------------------------------------
# FlowLab (sistema Lab) — Supabase de origem do login e da importacao de usuarios
# ---------------------------------------------------------------------------
# Modo admin da importacao (opcional): listar usuarios via service role
FLOWLAB_SUPABASE_URL=
FLOWLAB_SERVICE_ROLE_KEY=
# Modo login da importacao: entrar com um usuario do FlowLab para ler os perfis
FLOWLAB_SUPABASE_ANON_KEY=
FLOWLAB_IMPORT_EMAIL=
FLOWLAB_IMPORT_PASSWORD=

